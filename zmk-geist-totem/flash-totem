#!/usr/bin/env bash
#
# Usage: ./flash-totem [-f FOLDER] [dongle|left|right|settings_reset]
#
# Flash one TOTEM device (dongle, a half, or the settings reset firmware) from
# a firmware folder next to this script. Asks for anything not given:
#
#   - folder: the current directory if it holds firmware, else a menu of the
#     dongle-era firmware folders (newest first)
#   - device: a menu
#
# Before copying it
#   - verifies SHA256SUMS (written by fetch-totem) and that the file is a valid
#     nRF52840 UF2 image,
#   - waits (max. 2 min) for exactly one USB drive labelled XIAO-SENSE whose
#     INFO_UF2.TXT names the Seeed XIAO nRF52840 bootloader,
#   - shows what it is about to flash and asks for confirmation.
#
# Afterwards it waits for the device to reboot and, for the dongle, checks that
# it comes back as the TOTEM keyboard.
#
# Keymap changes: flash only the dongle. ZMK update / hardware config change:
# flash dongle and both halves from the same folder.
#
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=totem-lib.sh
source "$here/totem-lib.sh"

usage="usage: flash-totem [-f FOLDER] [dongle|left|right|settings_reset]"

fwdir=""
while getopts ":f:h" opt; do
  case "$opt" in
    f) fwdir="$OPTARG" ;;
    h) info "$usage"; exit 0 ;;
    *) die "$usage" ;;
  esac
done
shift $((OPTIND - 1))
[ $# -le 1 ] || die "$usage"
device="${1:-}"
if [ -n "$device" ]; then
  case " ${TOTEM_DEVICES[*]} " in *" $device "*) ;; *) die "$usage" ;; esac
fi

for cmd in lsblk findmnt udisksctl sha256sum od awk; do
  command -v "$cmd" >/dev/null || die "$cmd is not installed"
done

# --- folder -----------------------------------------------------------------

is_fw_folder() { compgen -G "$1/*totem_dongle-*.uf2" >/dev/null; }

if [ -n "$fwdir" ]; then
  fwdir="$(cd "$fwdir" && pwd)" || die "no such folder: $fwdir"
elif is_fw_folder "$PWD"; then
  fwdir="$PWD"
else
  choices=()
  while IFS= read -r d; do
    is_fw_folder "$d" && choices+=("$(basename "$d")")
  done < <(find "$here" -mindepth 1 -maxdepth 1 -type d -name '20*' | sort -r)
  [ "${#choices[@]}" -gt 0 ] || die "no firmware folders found - run ./fetch-totem first"
  info "Firmware folders (newest first):"
  fwdir="$here/$(pick "Folder" "${choices[@]}")"
fi
is_fw_folder "$fwdir" || die "$fwdir has no dongle firmware (pre-dongle folder?) - refusing to mix setups"

verify_folder "$fwdir"

# --- device -----------------------------------------------------------------

if [ -z "$device" ]; then
  info "Device (keymap changes: dongle only):"
  device="$(pick "Device" "${TOTEM_DEVICES[@]}")"
fi

matches=("$fwdir"/*"$device"-*.uf2)
[ "${#matches[@]}" -eq 1 ] && [ -f "${matches[0]}" ] || die "expected exactly one $device .uf2 in $fwdir"
uf2="${matches[0]}"

# --- bootloader drive -------------------------------------------------------

# Print the XIAO bootloader drives currently attached via USB.
find_drives() {
  lsblk -nrpdo NAME,LABEL,TRAN | awk -v l="$TOTEM_LABEL" '$2 == l && $3 == "usb" {print $1}'
}

case "$device" in
  dongle) how="double-tap the button on the dongle case" ;;
  left|right) how="double-tap the reset button on the $device half (USB powers it, the switch doesn't matter)" ;;
  settings_reset) how="double-tap the reset button on the device you want to reset" ;;
esac

mapfile -t drives < <(find_drives)
if [ "${#drives[@]}" -eq 0 ]; then
  info ""
  info ">>> Bootloader mode: $how"
  info "    Waiting up to 2 minutes for the $TOTEM_LABEL drive (Ctrl-C to abort)..."
  for _ in $(seq 240); do
    mapfile -t drives < <(find_drives)
    [ "${#drives[@]}" -eq 0 ] || break
    sleep 0.5
  done
fi
[ "${#drives[@]}" -gt 0 ] || die "no $TOTEM_LABEL drive appeared"
[ "${#drives[@]}" -eq 1 ] \
  || die "more than one $TOTEM_LABEL drive attached (${drives[*]}) - put only one device into bootloader mode"
dev="${drives[0]}"

mnt="$(findmnt -nro TARGET -S "$dev" || true)"
if [ -z "$mnt" ]; then
  udisksctl mount --no-user-interaction -b "$dev" >/dev/null
  for _ in $(seq 20); do
    mnt="$(findmnt -nro TARGET -S "$dev" || true)"
    [ -z "$mnt" ] || break
    sleep 0.5
  done
  [ -n "$mnt" ] || die "could not mount $dev"
fi

grep -qx "Board-ID: $TOTEM_BOARD_ID" "$mnt/INFO_UF2.TXT" 2>/dev/null \
  || die "$dev ($mnt) is not a $TOTEM_BOARD_ID bootloader"

info ""
info "Folder:   $(basename "$fwdir")"
if [ -f "$fwdir/BUILD-INFO" ]; then
  info "Commit:   $(sed -n 's/^commit=//p' "$fwdir/BUILD-INFO" | cut -c1-12) $(sed -n 's/^title=//p' "$fwdir/BUILD-INFO")"
fi
info "Firmware: $(basename "$uf2")"
info "Target:   $dev at $mnt"
[ "$device" != settings_reset ] || warn "settings_reset erases all pairings on this device"
if ! confirm "Flash it? The device in bootloader mode must be the $device."; then
  udisksctl unmount --no-user-interaction -b "$dev" >/dev/null 2>&1 || true
  exit 1
fi

# --- flash ------------------------------------------------------------------

# The bootloader reboots as soon as it has the last block, so cp/sync can
# report an error even though flashing worked; the reboot is the real signal.
copy_ok=1
{ cp -- "$uf2" "$mnt/" && sync; } || copy_ok=0

gone=0
for _ in $(seq 60); do
  if [ "$(lsblk -ndo LABEL "$dev" 2>/dev/null)" != "$TOTEM_LABEL" ]; then gone=1; break; fi
  sleep 0.5
done
[ "$gone" -eq 1 ] || die "the device did not reboot - flashing probably failed, try again"
[ "$copy_ok" -eq 1 ] || warn "the copy reported an error, but the device rebooted (usually fine)"

if [ "$device" = dongle ] && command -v lsusb >/dev/null; then
  for _ in $(seq 20); do
    if lsusb | grep -q ' TOTEM$'; then
      info "Done. The dongle is back as the TOTEM keyboard."
      exit 0
    fi
    sleep 0.5
  done
  die "the dongle rebooted but didn't come back as the TOTEM keyboard - check it"
fi
info "Done. The $device is rebooting with $(basename "$uf2")."
