[calendars]

[[nextcloud]]
path = ~/.local/share/calendars/*
type = discover

[locale]
timeformat = %H:%M
dateformat = %d.%m.%Y
longdateformat = %d.%m.%Y
datetimeformat = %d.%m.%Y %H:%M
longdatetimeformat = %d.%m.%Y %H:%M
firstweekday = 0

[default]
highlight_event_days = True

[palette]
# default "edit focus" is white on light blue — unreadable while typing
edit focus = black, yellow, bold, '#000000', '#ffd75f'
