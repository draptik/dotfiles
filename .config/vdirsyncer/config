# Sync Nextcloud calendars to a local vdir (read by khal and waybar).
# Password: Nextcloud app password stored in the keyring, see ../khal/README.md
[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair nextcloud_calendar]
a = "nextcloud_calendar_local"
b = "nextcloud_calendar_remote"
collections = ["from b"]
metadata = ["color", "displayname"]

[storage nextcloud_calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[storage nextcloud_calendar_remote]
type = "caldav"
url = "https://wolke.pdrechsler.de/remote.php/dav/"
username = "patrick"
password.fetch = ["command", "secret-tool", "lookup", "service", "vdirsyncer", "account", "nextcloud"]
